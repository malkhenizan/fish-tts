# Required in production — Bearer token for /v1/* endpoints
API_KEY=change-me-to-a-long-random-string

# Public wrapper port (Coolify reverse-proxy target)
PORT=8080

# Internal Fish Speech API (loopback only)
FISH_SPEECH_HOST=127.0.0.1
FISH_SPEECH_PORT=8081

# Inference
DEVICE=cuda
COMPILE=1
HALF=0

# Optional: Hugging Face token if fishaudio/s2-pro requires auth
HF_TOKEN=

# Optional: skip weight download even if empty (not recommended)
SKIP_WEIGHT_DOWNLOAD=0
